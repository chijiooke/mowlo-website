NOTION_TOKEN=secret_...
# Print-partner applications (/partners)
NOTION_DATABASE_ID=...
# Mobile-app waitlist signups (/#app). If unset, signups are accepted but not persisted.
# Database needs: WhatsApp (title), Source (select), Submitted At (date)
NOTION_WAITLIST_DATABASE_ID=...
# The web app (apply, sell, order print). Every "Use Mowlo", "Apply to sell" and
# "Start printing" button links here. NEXT_PUBLIC_APP_URL is the older name.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:5173
NEXT_PUBLIC_SITE_URL=https://mowlo.co
